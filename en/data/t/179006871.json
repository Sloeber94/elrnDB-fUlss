[[2,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Remove the oil filler cap.</p><p>2. Release the coil cover removing it from the press fastenings.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179001325.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the coil cover exerting moderate pressure to fit it correctly in the housings.</p><p>- Fit the oil filler plug.</p>"]]