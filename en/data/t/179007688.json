[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts fixing the hinges to the roof rear crossmember.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179004875.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Remove the tailgate hinges.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179004876.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the tailgate hinges.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Fit the adhesive seal on the hinges (roof rear crossmember fastening side).</p></aside><p>- Screw in the bolts fixing the hinges to the roof rear crossmember without tightening to torque.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>The tailgate must be fitted in position in order to adjust the hinges.</p></aside>"]]