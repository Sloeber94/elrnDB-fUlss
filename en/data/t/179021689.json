[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the bonnet.</p><p>1. Release the sound insulation from the retaining clips.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179008239.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Remove the bonnet lid sound insulation.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179008240.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the bonnet lid sound insulation.</p><p>- Secure the sound insulation fastening clips.</p><p>- Close the bonnet.</p>"]]