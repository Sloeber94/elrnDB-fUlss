[[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p><strong>See in Op. 1048A10</strong></p>"],[1,3,0,"<p>1. Lift up the resonator releasing it from the lower connectors (1a) and from the connector (1b), then remove the actual resonator (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179002825.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the resonator removed previously and renew the fastenings.</p><p><strong>See in Op. 1048A10</strong></p>"]]