[[2,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the fixing bolts (1a) and (1b) then remove the engine oil intake duct (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179003479.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,3,0,"<p>1. Remove the gasket.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179003480.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Replace the gasket.</p><p>- Place the intake duct in position and tighten the fixing bolts to the recommended torque.</p><div class=\"table\"><table><tr><th><img class=\"icon\" src=\"../media/179000410.jpg\" alt=\"\" loading=\"lazy\"></th><th><p>Value - daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>Ø</p></th></tr><tr><td><p>.</p></td><td><p>0.8</p></td><td><p>Bolt</p></td><td><p>ENGINE OIL INTAKE DUCT - R.R ON CRANKCASE SUMP</p></td><td></td></tr></table></div>"],[1,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the fixing nuts and bolts (1a) and remove the engine oil intake duct (1b).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179003482.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Place the intake duct in position and tighten the fixing nuts and bolts.</p>"],[4,3,0,"<p><strong>See in Op. 1084B10</strong></p>"],[8,3,0,"<p><strong>See in Op. 1084B10</strong></p>"]]