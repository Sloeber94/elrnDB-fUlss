[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Release and remove the bodyshell mounting.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179004561.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Undo the retaining bolt.</p><p>2. Remove the side pipe guard.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179004562.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Release the air conditioning heater radiator and remove it.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179004563.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the air conditioning heater radiator.</p><p>- Fit the side pipe guard and tighten the retainining bolt.</p><p>- Place the bodyshell mounting in position.</p>"]]