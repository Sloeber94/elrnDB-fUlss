[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>- Open the bonnet.</p><p>1. Release the stay from the fastening clip.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179005031.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Remove the bonnet stay.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>a second mechanic is needed to carry out this operation.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179005032.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Position the bonnet stay.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>a second mechanic is needed to carry out this operation.</p></aside><p>- Secure the stay to the fastening clip.</p><p>- Close the bonnet.</p>"]]