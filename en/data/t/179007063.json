[[8,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Undo the fixing nuts (1a) and separate the exhaust manifold (1b) from the turbocharger (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179007534.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Replace the seal and fit the turbocharger on the exhaust manifold and tighten the fixing nuts to torque.</p><div class=\"table\"><table><tr><th></th><th><p>daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>dia</p></th></tr><tr><td><p>1a</p></td><td><p>2.5</p></td><td><p>Nut</p></td><td><p>TURBOCHARGER</p></td><td></td></tr></table></div><aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><p>Always replace the self-locking nuts with new ones.</p></aside>"],[4,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the fixing nuts (1a) and separate the exhaust manifold (1b) from the turbocharger (1c).</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179007535.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[12,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Replace the seal and fit the turbocharger on the exhaust manifold and tighten the fixing nuts to torque.</p><div class=\"table\"><table><tr><th></th><th><p>daNm</p></th><th><p>Fastening</p></th><th><p>Component</p></th><th><p>dia</p></th></tr><tr><td><p>1a</p></td><td><p>2.5</p></td><td><p>Nut</p></td><td><p>TURBOCHARGER</p></td><td></td></tr></table></div><aside class=\"note\"><img class=\"icon\" src=\"../media/769.jpg\" alt=\"\" loading=\"lazy\"><p>Always replace the self-locking nuts with new ones.</p></aside>"]]