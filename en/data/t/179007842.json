[[15,3,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the rear bolts fixing the seat support.</p><p>2. Undo the front bolts fixing the seat support.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179005169.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<p>1. Remove the front driver&#x27;s seat support.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/179005170.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[15,3,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>- Fit the front driver&#x27;s seat support.</p><p>- Tighten the front bolts fixing the front driver&#x27;s seat support.</p><p>- Tighten the rear bolts fixing the front driver&#x27;s seat support.</p>"]]